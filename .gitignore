# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables (never commit real credentials)
.env
.env.*
!.env.example

# Private keys / secrets
*.pem
*.key

# Database
Database/*.db
Database/*.db-shm
Database/*.db-wal
Database/bhavcopy/

# Logs
Logs/
*.log
*.log.*

# State files (contain runtime positions/tokens/secrets)
State/zerodha_token.json
State/crave_state.json
State/crave_positions.json
State/crave_heartbeats.json
State/chaos_results.json

# ML models
ml/models/*.pkl
ml/models/*.joblib

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Backtest outputs (generated files, not source)
backtesting/*.pdf
backtesting/*.html
backtesting/*_results.json
wfo_results.json

# Patch/update archives (applied and removed)
updates*.zip
updates_*/
updates_unzipped/

# Downloaded / generated data
data/*.parquet
data/*.db
data/*.json
data/historical/

# Executables and installers
*.exe

# Scratch / temporary
*.docx
*.pdf
ollama_results.txt

# pytest
.pytest_cache/