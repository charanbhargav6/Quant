State/*.tmp
State/*.bak

# ML models
ml/models/*.pkl
ml/models/*.joblib

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Backtest outputs (generated files, not source)
backtesting/*.pdf
backtesting/*.html
backtesting/*_results.json
wfo_results.json

# Patch/update archives (applied and removed)
updates*.zip
updates_*/
updates_unzipped/

