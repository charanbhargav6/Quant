# ═══════════════════════════════════════════
# Trading Engine — Environment Variables
# ═══════════════════════════════════════════
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# --- Core ---
# ENGINE_ROOT is derived from the checkout location; set only if an integration requires it.
TRADING_MODE=paper                  # paper / live (paper is the safe default)
MIN_TRADES_FOR_LIVE=30
ENFORCE_LIVE_READY_GATE=true
ENABLE_VOLATILITY_BREAKOUT=false  # paper-only XAUUSD research candidate
ALLOW_EVOLVER_AUTO_PROMOTE=false   # require manual review of LLM parameter proposals
ALLOW_HEURISTIC_EVOLUTION=false    # keep false until real WFO/backtest is wired
# Optional council provider; supply your own key only after reviewing provider terms
COUNCIL_OPENAI_API_KEY=
COUNCIL_OPENAI_BASE_URL=https://api.openai.com/v1
COUNCIL_OPENAI_MODEL=gpt-5-mini

# --- Prop Firm ---
PROP_FIRM=fundingpips               # ftmo, the5ers, fundingpips
ACCOUNT_SIZE=10000                  # Must match PAPER_TRADING starting_equity

# --- Telegram Bot (Required) ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Binance (Crypto Futures) ---
BINANCE_API_KEY=your_binance_key
BINANCE_API_SECRET=your_binance_secret

# --- Alpaca (US stocks; forex/metals use MT5 in this repository) ---
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER_URL=https://paper-api.alpaca.markets

# --- MetaTrader 5 (forex and metals live execution) ---
# MT5 requires a locally installed/running terminal on a supported host.
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# --- Zerodha (Indian Market) ---
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=http://127.0.0.1:5000/callback
# ZERODHA_ACCESS_TOKEN is auto-refreshed daily via TOTP
# ZERODHA_TOTP_KEY=your_totp_secret  # For auto-login (optional)

# --- Polygon.io (Better US market data, optional) ---
# POLYGON_API_KEY=your_polygon_key

# --- State Sync (Multi-node) ---
# CRAVE_STATE_REPO=your_github_repo
# GITHUB_TOKEN=your_github_token

# --- AWS (Cloud node) ---
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_KEY_NAME=your_key_name

# --- Supabase (Always-on Dashboard) ---
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# --- News & Intelligence ---
# NEWS_API_KEY=your_news_api_key
# GNEWS_API_KEY=your_gnews_api_key

# --- LLM for Jarvis (Trade analysis AI) ---
# GEMINI_API_KEY=your_gemini_key
# GROQ_API_KEY=your_groq_key

# Fernet key for encrypting stored account passwords/secrets
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=your-generated-fernet-key-here
