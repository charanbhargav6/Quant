# Crave Quant Profile: Binance
# Usage: This profile uses CCXT to trade Binance USDT-M Futures

BROKER_TYPE=BINANCE
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional: Disable MT5 entirely for this profile so it doesn't even try
MT5_TERMINAL_PATH=

# Core Settings
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_BOT_TOKEN=your_bot_token

# Capital Settings
ACCOUNT_SIZE=1000
SERVER_PORT=8766
