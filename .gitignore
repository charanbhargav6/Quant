# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables (never commit real credentials)
.env
.env.*
!.env.example

# Private keys / secrets
*.pem
*.key
*.token
*.token.json
*.session
*credentials*.json
*.p12
*.pfx

# Database
Database/*.db
Database/*.db-shm
Database/*.db-wal
Database/bhavcopy/
*.sqlite
*.sqlite3

# Logs
Logs/
*.log
*.log.*

# State files (contain runtime positions/tokens/secrets)
State/zerodha_token.json
State/crave_state.json
State/crave_positions.json
State/crave_heartbeats.json
State/chaos_results.json
State/strategy_candidates.json
