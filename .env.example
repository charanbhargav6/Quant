# =============================================================================
# CRAVE Quant Engine — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or any live credentials to version control!

# --- Core Engine ---
# ENGINE_ROOT is derived from checkout location; set only if an integration requires it.
ENGINE_ROOT="D:\Desktop\engine"
TRADING_MODE=paper                  # paper / live (paper is the safe default)
MIN_TRADES_FOR_LIVE=30
ENFORCE_LIVE_READY_GATE=true
ENABLE_VOLATILITY_BREAKOUT=false   # paper-only research candidate
ALLOW_EVOLVER_AUTO_PROMOTE=false    # require manual review of LLM parameter proposals
ALLOW_HEURISTIC_EVOLUTION=false     # keep false until real WFO/backtest is wired
SERVER_PORT=8765

# --- MetaTrader 5 (Forex & Metals) ---
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Prop Firm & Capital ---
PROP_FIRM=fundingpips               # ftmo, the5ers, fundingpips, xm (no rules)
ACCOUNT_SIZE=10000                  # Account initial balance / size

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Binance (Crypto Futures) ---
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_SECRET_KEY=your_binance_api_secret

# --- Alpaca (US Stocks / Paper) ---
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Zerodha (Indian Market) ---
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=http://127.0.0.1:5000/callback
# ZERODHA_ACCESS_TOKEN is auto-refreshed daily via TOTP
# ZERODHA_TOTP_KEY=your_totp_secret

# --- Supabase (Dashboard Sync) ---
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- AI Models & Council (OpenAI, Gemini, Groq, OpenRouter) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
COUNCIL_OPENAI_API_KEY=your_openai_api_key
COUNCIL_OPENAI_BASE_URL=https://api.openai.com/v1
COUNCIL_OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
TAVILY_API_KEY=your_tavily_api_key

# --- News & Sentiment ---
NEWS_API_KEY=your_news_api_key
GNEWS_API_KEY=your_gnews_api_key

# --- ML & Advanced Settings ---
USE_DEEP_REGIME=true
MAX_CONCURRENT_ORDERFLOW_BTC=1

# --- Security / Encryption ---
# Fernet key for encrypting stored account passwords in SQLite
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=your-generated-fernet-key-here

# ── Backtest pipeline (all optional) ─────────────────────────────────────────
# MT5 server time -> UTC. VERIFY with: python -m backtesting.pipeline.mt5_downloader --probe --symbol XAUUSD=X
BT_MT5_SERVER_UTC_OFFSET=2          # broker winter offset in hours (XM = 2)
BT_MT5_SERVER_DST_RULE=us           # us | eu | none
# BT_SYMBOL_OVERRIDES={"XAUUSD=X":"GOLD#"}
BT_RISK_PER_TRADE=0.01
BT_MAX_OPEN_TRADES=1
BT_COMMISSION_PER_LOT_RT=0          # account currency per 1.0 lot round turn (0 for spread-only accounts)
BT_COUNCIL_ON_PHASE_FAILURE=false   # also send MC/WFO/Sensitivity failures to the council (default: only negative backtests)
# CRAVE_API_TOKEN=change-me         # if set, dashboard must send X-CRAVE-Token for run/cancel
# CRAVE_ALLOWED_ORIGINS=http://192.168.1.10:5000
